{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pixi run --manifest-path \"$CLAUDE_PROJECT_DIR/pixi.toml\" --frozen python \"$CLAUDE_PROJECT_DIR/scripts/hooks/post_tool_use.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pixi run --manifest-path \"$CLAUDE_PROJECT_DIR/pixi.toml\" --frozen python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop.py\"",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
